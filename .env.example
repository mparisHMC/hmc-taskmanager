# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
SESSION_SECRET=change_this_to_a_long_random_string

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite file path (relative to server/)
DB_PATH=./taskflow.db

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Get from https://console.cloud.google.com → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# ─── Slack ────────────────────────────────────────────────────────────────────
# Get from https://api.slack.com/apps → your app → OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your_slack_signing_secret
# Your Slack user ID (so the bot knows who to DM for alerts)
SLACK_USER_ID=U0000000000

# ─── Web App ──────────────────────────────────────────────────────────────────
# URL of the backend (used by web + mobile)
API_BASE_URL=http://localhost:3001

# ─── Notifications ────────────────────────────────────────────────────────────
# Time for daily digest (24h format, server's local timezone)
DAILY_DIGEST_TIME=08:00
# Day for weekly review (0=Sunday, 1=Monday, ..., 5=Friday, 6=Saturday)
WEEKLY_REVIEW_DAY=1
